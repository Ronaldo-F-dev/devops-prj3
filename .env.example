APP_NAME=KPS Tasks API
APP_ENV=production
APP_VERSION=0.1.0
LOG_LEVEL=INFO

APP_PORT=8000

POSTGRES_DB=change_me
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me

# Use the service name db when the stack runs in Docker Compose.
DATABASE_URL=postgresql+psycopg://kps_tasks_user:change_me@db:5432/kps_tasks_db
